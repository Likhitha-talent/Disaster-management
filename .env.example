# Environment Variables Configuration
# Copy this file to .env to configure optional external services.
# NOTE: The current prototype runs 100% locally with NO API keys required!

# --- Server Configuration ---
API_HOST=127.0.0.1
API_PORT=8000
ENVIRONMENT=development

# --- Optional External Services ---
# Mapbox (Optional: Only if replacing open Leaflet/Carto tiles with Mapbox GL Satellite tiles)
# Get from: https://account.mapbox.com/ (Free tier: 50,000 map loads/month)
MAPBOX_ACCESS_TOKEN=

# Copernicus Data Space Ecosystem (Optional: For automated Sentinel-2 / DEM fetching)
# Get from: https://dataspace.copernicus.eu/ (100% Free academic registration)
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# Database (Optional: If connecting to external PostgreSQL/PostGIS instead of local store)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/disaster_db

